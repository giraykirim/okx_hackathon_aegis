# Copy with scripts.init_local; keep .env local and mode 0600.
AEGIS_SOURCE_MODE=MARKET_ONLY
AEGIS_CONTROL_TOKEN=
# Separate assessment-only credential; never use trading keys or the control token.
AEGIS_SERVICE_API_KEY=
AEGIS_SERVICE_SOURCE_MODE=MARKET_ONLY
AEGIS_SERVICE_REQUESTS_PER_MINUTE=6
AEGIS_SERVICE_TIMEOUT_SECONDS=30
AEGIS_CYCLE_SECONDS=10
AEGIS_CYCLE_TIMEOUT_SECONDS=180
AEGIS_MOCK_AUTONOMOUS_SCENARIO=normal
AEGIS_OKX_SITE=tr
AEGIS_ATK_TRANSPORT=mcp

# Optional: RTX LAN LAYA service. Never deployed to the EVM.
AEGIS_LAYA_URL=
AEGIS_LAYA_TOKEN=

# EVREN uses X-API-Key; key stays in this file. Select an ID from account /models.
AEGIS_EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
AEGIS_EVREN_API_KEY=
AEGIS_EVREN_MODEL=

# Exchange writes stay disabled unless ALL demo conditions are met.
# Only isolated DEMO keys with Read + Trade, no Withdraw. Cash account level 1.
AEGIS_DEMO_ENABLED=false
AEGIS_DEMO_REGION_CONFIRMED=false
AEGIS_OKX_DEMO_API_KEY=
AEGIS_OKX_DEMO_SECRET_KEY=
AEGIS_OKX_DEMO_PASSPHRASE=
